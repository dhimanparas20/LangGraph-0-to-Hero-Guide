# Copy this file to .env and fill in your values (.env is gitignored)

# ---------------------------------------------------------------------------
# LLM provider: openai | vercel | opencode | opencode-go
# - openai      → direct OpenAI (needs OPENAI_API_KEY)
# - vercel      → Vercel AI Gateway (needs AI_GATEWAY_API_KEY)
# - opencode    → OpenCode Console / Zen, pay-as-you-go (needs OPENCODE_API_KEY)
# - opencode-go → OpenCode Go / Go Plus subscription (needs OPENCODE_API_KEY)
# Leave unset to auto-select: vercel when AI_GATEWAY_API_KEY is present,
# else opencode when OPENCODE_API_KEY is present, else openai.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=opencode-go

# OpenCode Console (https://opencode.ai/console) — one key covers both
# pay-as-you-go (Zen) and the Go subscription; LLM_PROVIDER picks the gateway.
OPENCODE_API_KEY=your-opencode-api-key-here
# Base URL is derived from the provider; override only if needed:
#   zen default: https://opencode.ai/inference/openai/v1
#   go default:  https://opencode.ai/inference/go/openai/v1
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Session id sent as x-opencode-session (Go requires one; defaults to a
# generated per-process id, so you usually don't need to set this)
# OPENCODE_SESSION_ID=my-chatbot-session

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway)
# Create a key: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=your-ai-gateway-api-key-here
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Direct OpenAI (used when LLM_PROVIDER=openai, and for embeddings fallback
# when chat runs on OpenCode — the OpenCode gateway serves chat models only)
OPENAI_API_KEY=sk-your-key-here

# Model IDs — set per provider:
# - OPENCODE_MODEL: used by opencode / opencode-go. Bare catalog ids, e.g.
#   glm-5.3-flash, kimi-k2.7-code, deepseek-v4.1-flash (https://opencode.ai/models).
#   A leading opencode/ or opencode-go/ slug is stripped.
# - OPENAI_MODEL: used by openai + vercel (and as fallback for opencode).
#   For the gateway, bare names like gpt-4o-mini become openai/gpt-4o-mini.
#   Full slugs pass through: openai/gpt-4o, anthropic/claude-sonnet-4.5, …
# - OPENAI_EMBEDDINGS_MODEL: used by every provider (OpenCode has no embeddings
#   models, so embeddings always run on openai/vercel).
OPENCODE_MODEL=glm-5.3-flash
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# Optional: embeddings provider when it should differ from the chat provider
# (openai | vercel | opencode). Defaults to the chat provider, except
# opencode/opencode-go which fall back to openai.
# EMBEDDINGS_PROVIDER=openai

# MongoDB (chat history storage) - optional, chatbot works without it
MONGO_URI=mongodb://localhost:27017

# Redis (web tool result cache) - optional, chatbot works without it
REDIS_URL=redis://localhost:6379/0

# MCP servers (modules/tools/mcp_tools.py) - optional
# true = connect MCP servers listed in MCP_TOOLS at startup
MCP_ENABLED=false
# used by the commented "real_estate_search" example server entry
# DEFAULT_MCP_SERVER_URL=http://localhost:8000/mcp/

# Agent file sandbox (modules/tools/file_tools.py) - the chatbot can only
# touch files INSIDE this directory. Defaults to ./datastore
DATASTORE_DIR=datastore
