# Copy this file to .env and fill in your values (.env is gitignored)

# ---------------------------------------------------------------------------
# LLM provider: openai | vercel
# - openai  → direct OpenAI (needs OPENAI_API_KEY)
# - vercel  → Vercel AI Gateway (needs AI_GATEWAY_API_KEY)
# Leave unset to auto-select vercel when AI_GATEWAY_API_KEY is present.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=vercel

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway)
# Create a key: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
# Once set, provider auto-selects vercel (or set LLM_PROVIDER=vercel explicitly).
AI_GATEWAY_API_KEY=your-ai-gateway-api-key-here
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Direct OpenAI (used when LLM_PROVIDER=openai, or when no gateway key is set)
OPENAI_API_KEY=sk-your-key-here

# Model IDs — same vars for both providers.
# For the gateway, bare names like gpt-4o-mini become openai/gpt-4o-mini.
# You can also set full gateway slugs: openai/gpt-4o, anthropic/claude-sonnet-4.5, …
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# MongoDB (chat history storage) - optional, chatbot works without it
MONGO_URI=mongodb://localhost:27017

# Redis (web tool result cache) - optional, chatbot works without it
REDIS_URL=redis://localhost:6379/0

# MCP servers (modules/tools/mcp_tools.py) - optional
# true = connect MCP servers listed in MCP_TOOLS at startup
MCP_ENABLED=false
# used by the commented "real_estate_search" example server entry
# DEFAULT_MCP_SERVER_URL=http://localhost:8000/mcp/

# Agent file sandbox (modules/tools/file_tools.py) - the chatbot can only
# touch files INSIDE this directory. Defaults to ./datastore
DATASTORE_DIR=datastore
